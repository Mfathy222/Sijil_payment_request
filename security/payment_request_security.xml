<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 user Access Rights selector shown under the Sales category. -->
    <record id="res_groups_privilege_payment_request" model="res.groups.privilege">
        <field name="name">Payment Request</field>
        <field name="sequence">2</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="placeholder">No Access</field>
        <field name="description">Controls access to Sales Payment Requests.</field>
    </record>

    <record id="group_payment_request_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_payment_request"/>
        <field name="comment">Create, view and edit only Payment Requests created by this user. Cannot delete Payment Requests or change the main Payment Request status.</field>
    </record>

    <record id="group_payment_request_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_payment_request"/>
        <field name="comment">Create, view, edit and delete Payment Requests for all users, and update the Payment Request status.</field>
    </record>

    <record id="group_payment_request_reader" model="res.groups">
        <field name="name">Reader</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_payment_request"/>
        <field name="comment">Read and print all Payment Requests only. Cannot create, edit or delete them.</field>
    </record>

    <!-- Multi-company restrictions are GLOBAL so they intersect with the
         User own-record rules instead of being OR'ed with them.  (5, 0, 0)
         also clears the old sales-team group relation on module upgrade. -->
    <record id="Sijil_payment_request_company_rule" model="ir.rule">
        <field name="name">Payment Request: multi-company</field>
        <field name="model_id" ref="model_sale_payment_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="Sijil_payment_request_line_company_rule" model="ir.rule">
        <field name="name">Payment Request Line: multi-company</field>
        <field name="model_id" ref="model_sale_payment_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <!-- USER: only own Payment Requests and their lines. -->
    <record id="payment_request_user_own_rule" model="ir.rule">
        <field name="name">Payment Request User: own requests only</field>
        <field name="model_id" ref="model_sale_payment_request"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>

    <record id="payment_request_line_user_own_rule" model="ir.rule">
        <field name="name">Payment Request User: own request lines only</field>
        <field name="model_id" ref="model_sale_payment_request_line"/>
        <field name="domain_force">[('payment_request_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_payment_request_user'))]"/>
    </record>
</odoo>
