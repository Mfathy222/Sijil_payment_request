<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_inherit_payment_request" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.payment.request</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="payment_request_active_company_visible" invisible="1"/>
                <button name="action_open_payment_request_wizard"
                        string="Payment Request"
                        type="object"
                        class="btn-secondary"
                        groups="Sijil_payment_request.group_payment_request_user,Sijil_payment_request.group_payment_request_supervisor"
                        invisible="state == 'cancel' or not payment_request_active_company_visible"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_payment_requests"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        groups="Sijil_payment_request.group_payment_request_user,Sijil_payment_request.group_payment_request_supervisor,Sijil_payment_request.group_payment_request_reader"
                        invisible="payment_request_count == 0 or not payment_request_active_company_visible">
                    <field name="payment_request_count"
                           widget="statinfo"
                           string="Payment Requests"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
