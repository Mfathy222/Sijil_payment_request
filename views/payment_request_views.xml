<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_Sijil_payment_request_list" model="ir.ui.view">
        <field name="name">sale.payment.request.list</field>
        <field name="model">sale.payment.request</field>
        <field name="arch" type="xml">
            <list string="Payment Requests" default_order="create_date desc" create="true" import="true">
                <field name="name"/>
                <field name="quotation_request_number" string="Payment No." class="sijil-pr-ltr-number"/>
                <field name="partner_id"/>
                <field name="create_date" string="Creation Date"/>
                <field name="due_date"/>
                <field name="status" widget="badge" decoration-danger="status == 'unpaid'" decoration-warning="status == 'partial'" decoration-success="status == 'paid'" decoration-muted="status == 'cancelled'"/>
                <field name="user_id"/>
                <field name="sale_order_id" optional="show"/>
                <field name="total_request_amount" widget="monetary" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_Sijil_payment_request_quotation_list" model="ir.ui.view">
        <field name="name">sale.payment.request.quotation.list</field>
        <field name="model">sale.payment.request</field>
        <field name="arch" type="xml">
            <list string="Payment Requests" default_order="create_date asc, id asc" create="false">
                <header>
                    <button name="action_create_invoice_from_selected_requests" type="object" string="Create Invoice" icon="fa-file-text-o" class="btn-primary" groups="Sijil_payment_request.group_payment_request_user,Sijil_payment_request.group_payment_request_supervisor"/>
                </header>
                <field name="quotation_request_number" string="Batch" class="sijil-pr-ltr-number"/>
                <field name="partner_id"/>
                <field name="create_date" string="Creation Date"/>
                <field name="due_date"/>
                <field name="status" widget="badge" decoration-danger="status == 'unpaid'" decoration-warning="status == 'partial'" decoration-success="status == 'paid'" decoration-muted="status == 'cancelled'"/>
                <field name="user_id"/>
                <field name="total_request_amount" widget="monetary" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_Sijil_payment_request_search" model="ir.ui.view">
        <field name="name">sale.payment.request.search</field>
        <field name="model">sale.payment.request</field>
        <field name="arch" type="xml">
            <search string="Payment Requests">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="user_id"/>
                <filter string="Not Paid" name="status_unpaid" domain="[('status', '=', 'unpaid')]"/>
                <filter string="Partially Paid" name="status_partial" domain="[('status', '=', 'partial')]"/>
                <filter string="Paid" name="status_paid" domain="[('status', '=', 'paid')]"/>
                <filter string="Cancelled" name="status_cancelled" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Creation Date" name="create_date" date="create_date"/>
                <filter string="Due Date" name="due_date" date="due_date"/>
                <group>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Quotation" name="group_sale_order" context="{'group_by': 'sale_order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_Sijil_payment_request_form" model="ir.ui.view">
        <field name="name">sale.payment.request.form</field>
        <field name="model">sale.payment.request</field>
        <field name="arch" type="xml">
            <form string="Payment Request">
                <header>
                    <button name="action_create_invoice_from_selected_requests" type="object" string="Create Invoice" icon="fa-file-text-o" class="btn-primary" groups="Sijil_payment_request.group_payment_request_user,Sijil_payment_request.group_payment_request_supervisor" invisible="status == 'cancelled' or invoice_count &gt; 0"/>
                    <button name="action_cancel_payment_request" type="object" string="Cancel" icon="fa-ban" class="btn-secondary" groups="Sijil_payment_request.group_payment_request_supervisor" invisible="status == 'cancelled' or invoice_count &gt; 0"/>
                    <button name="action_set_to_pr" type="object" string="Set to PR" icon="fa-undo" class="btn-primary" groups="Sijil_payment_request.group_payment_request_supervisor" invisible="status != 'cancelled'"/>
                    <button name="action_print_audit_payment_request" type="object" string=" Print SNB" icon="fa-print" class="btn-primary" groups="Sijil_payment_request.group_payment_request_user,Sijil_payment_request.group_payment_request_supervisor,Sijil_payment_request.group_payment_request_reader" invisible="not snb_print_visible"/>
                    <button name="action_print_bookeeping_payment_request" type="object" string=" Print Alinma" icon="fa-print" class="btn-primary" groups="Sijil_payment_request.group_payment_request_user,Sijil_payment_request.group_payment_request_supervisor,Sijil_payment_request.group_payment_request_reader"/>
                    <field name="status" widget="statusbar" statusbar_visible="unpaid,partial,paid,cancelled" options="{'clickable': True}" groups="Sijil_payment_request.group_payment_request_supervisor"/>
                    <field name="status" widget="statusbar" statusbar_visible="unpaid,partial,paid,cancelled" readonly="1" groups="Sijil_payment_request.group_payment_request_user,Sijil_payment_request.group_payment_request_reader"/>
                </header>
                <sheet>
                    <field name="snb_print_visible" invisible="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payment_request_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="invoice_count == 0">
                            <field name="invoice_count"
                                   string="Invoices"
                                   widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="quotation_request_number" string="Payment No." readonly="1" class="sijil-pr-ltr-number"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="create_date" string="Creation Date" readonly="1"/>
                            <field name="due_date" readonly="0"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="quotation_product_display_name" string="Product" readonly="1"/>
                                    <field name="product_id" column_invisible="True"/>
                                    <field name="product_uom_qty" readonly="1" digits="[16, 3]"/>
                                    <field name="price_unit" readonly="1"/>
                                    <field name="base_amount" widget="monetary" readonly="1"/>
                                    <field name="due_date"/>
                                    <field name="payment_status"/>
                                    <field name="payment_percentage"/>
                                    <field name="payment_untaxed_amount" string="Total Before Tax" widget="monetary" readonly="1"/>
                                    <field name="payment_amount" widget="monetary" readonly="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>

                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_request_amount" widget="monetary" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_Sijil_payment_request" model="ir.actions.act_window">
        <field name="name">Payment Requests</field>
        <field name="res_model">sale.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_Sijil_payment_request_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Payment Requests from Sales quotations or orders.
            </p>
        </field>
    </record>
</odoo>
