#. module: Sijil_payment_request
#, python-format
msgid ""
"Payment Requests for product \"%(product)s\" cannot exceed 100%% of the "
"quotation line total including tax and quantity.\n"
"Already requested: %(already).2f%%\n"
"Remaining available: %(remaining).2f%%"
msgstr ""
"لا يمكن أن تتجاوز طلبات الدفع للمنتج \"%(product)s\" نسبة 100%% من إجمالي "
"سطر الكوتيشن شامل الضريبة والكمية.\n"
"النسبة المطلوبة سابقاً: %(already).2f%%\n"
"النسبة المتاحة: %(remaining).2f%%"

#. module: Sijil_payment_request
#, python-format
msgid ""
"A new Payment Request cannot be created for the following product(s) because "
"100%% of their quotation line total including tax and quantity has already "
"been requested:\n"
"%(products)s"
msgstr ""
"لا يمكن إنشاء طلب دفع جديد للمنتجات التالية لأنه تم بالفعل طلب 100%% من "
"إجمالي سطر الكوتيشن الخاص بها شامل الضريبة والكمية:\n"
"%(products)s"

